# ------------------------------------------------------------------
# Vorlage fuer die Umgebungsvariablen.
# Kopieren Sie diese Datei zu ".env" und tragen Sie die echten Werte ein.
# Die Werte finden Sie in v0 unter: Settings -> Vars
# Die .env-Datei darf NIEMALS in Git eingecheckt werden!
# ------------------------------------------------------------------

# Neon Postgres Datenbank (Cloud-Dienst)
DATABASE_URL="postgres://BENUTZER:PASSWORT@HOST/DATENBANK?sslmode=require"

# Geheimer Schluessel fuer die Anmeldung (Better Auth).
# Neuen Wert erzeugen mit:  openssl rand -base64 32
BETTER_AUTH_SECRET="hier-einen-langen-zufallswert-einsetzen"

# Oeffentliche Adresse Ihrer Seite. WICHTIG beim Self-Hosting,
# damit die Anmeldung korrekt funktioniert.
BETTER_AUTH_URL="https://www.mbc-bellenberg.de"

# Vercel Blob Speicher fuer Dokumente & Bilder (Cloud-Dienst)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
